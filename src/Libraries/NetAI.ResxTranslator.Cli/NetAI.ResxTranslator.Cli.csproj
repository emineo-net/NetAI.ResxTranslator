    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>netai-resx</AssemblyName>
    <RootNamespace>NetAI.ResxTranslator.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>netai-resx</ToolCommandName>
