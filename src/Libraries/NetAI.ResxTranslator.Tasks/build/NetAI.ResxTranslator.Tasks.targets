<Project>

	<PropertyGroup>
		<!-- Pfad zur Entwicklungs-DLL direkt im build-Ordner -->
		<ResxTranslatorTaskAssembly>$(MSBuildThisFileDirectory)NetAI.ResxTranslator.Tasks.dll</ResxTranslatorTaskAssembly>
		<!-- Wir prüfen, ob die DLL physisch existiert -->
		<ResxTranslatorTaskExists Condition="Exists('$(ResxTranslatorTaskAssembly)')">true</ResxTranslatorTaskExists>
	</PropertyGroup>

	<!-- TRICK: TaskHostFactory zwingt MSBuild, den Task in einem separaten Prozess zu starten. -->
	<!-- Dadurch wird die DLL NIEMALS von Visual Studio selbst gesperrt! -->
	<UsingTask Condition="'$(ResxTranslatorTaskExists)' == 'true'"
	           TaskName="NetAI.ResxTranslator.Tasks.ResxTranslatorTask"
	           AssemblyFile="$(ResxTranslatorTaskAssembly)"
	           TaskFactory="TaskHostFactory" />

	<!-- TARGET: Schema und Einstellungen erzeugen -->
	<Target Name="SetupResxTranslatorSettings" BeforeTargets="AssignTargetPaths">
		<Copy SourceFiles="$(MSBuildThisFileDirectory)..\aisettings-schema.json"
		      DestinationFiles="$(ProjectDir)aisettings-schema.json"
		      SkipUnchangedFiles="true"
		      Condition="!Exists('$(ProjectDir)aisettings-schema.json')" />

		<Copy SourceFiles="$(MSBuildThisFileDirectory)..\aisettings.json"
		      DestinationFiles="$(ProjectDir)aisettings.json"
		      SkipUnchangedFiles="true"
		      Condition="!Exists('$(ProjectDir)aisettings.json')" />

		<ItemGroup>
			<None Update="aisettings-schema.json">
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</None>
			<None Update="aisettings.json">
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</None>
		</ItemGroup>
	</Target>

	<!-- TARGET 1: Läuft beim normalen Build (NUR wenn DLL existiert) -->
	<Target Name="RunResxTranslation"
	        BeforeTargets="BeforeBuild"
	        DependsOnTargets="SetupResxTranslatorSettings"
	        Condition="'$(ResxTranslatorTaskExists)' == 'true' And !$(MSBuildProjectName.EndsWith('_wpftmp'))">

		<ResxTranslatorTask ProjectDir="$(ProjectDir)"
		                    CurrentConfiguration="$(Configuration)"
		                    IsPublishing="false" />
	</Target>

	<!-- TARGET 2: Läuft beim Publish (NUR wenn DLL existiert) -->
	<Target Name="RunResxTranslationOnPublish"
	        BeforeTargets="PrepareForPublish"
	        DependsOnTargets="SetupResxTranslatorSettings"
	        Condition="'$(ResxTranslatorTaskExists)' == 'true' And !$(MSBuildProjectName.EndsWith('_wpftmp'))">

		<ResxTranslatorTask ProjectDir="$(ProjectDir)"
		                    CurrentConfiguration="$(Configuration)"
		                    IsPublishing="true" />
	</Target>

</Project>
