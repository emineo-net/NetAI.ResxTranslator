<Project>

	<PropertyGroup>
		<!-- DLL-Suche: 1. NuGet-Paket (build\ liegt neben tasks\), 2. lokale Entwicklung (DLL direkt in build\) -->
		<ResxTranslatorTaskAssembly Condition="Exists('$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\NetAI.ResxTranslator.Tasks.dll')">$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\NetAI.ResxTranslator.Tasks.dll</ResxTranslatorTaskAssembly>
		<ResxTranslatorTaskAssembly Condition="'$(ResxTranslatorTaskAssembly)' == ''">$(MSBuildThisFileDirectory)NetAI.ResxTranslator.Tasks.dll</ResxTranslatorTaskAssembly>
		<ResxTranslatorTaskExists Condition="Exists('$(ResxTranslatorTaskAssembly)')">true</ResxTranslatorTaskExists>

		<!-- Abschalten mit: dotnet build -p:ResxTranslatorEnabled=false -->
		<ResxTranslatorActive>false</ResxTranslatorActive>
		<ResxTranslatorActive Condition="'$(ResxTranslatorEnabled)' != 'false' And '$(DesignTimeBuild)' != 'true' And '$(ResxTranslatorTaskExists)' == 'true' And !$(MSBuildProjectName.EndsWith('_wpftmp'))">true</ResxTranslatorActive>

		<!-- Bei Multi-Targeting soll die Übersetzung nur im ersten Target Framework laufen -->
		<_ResxTranslatorFirstTfm Condition="'$(TargetFrameworks)' != ''">$(TargetFrameworks.Split(';')[0])</_ResxTranslatorFirstTfm>
		<_ResxTranslatorIsFirstTfm>false</_ResxTranslatorIsFirstTfm>
		<_ResxTranslatorIsFirstTfm Condition="'$(TargetFrameworks)' == '' Or '$(TargetFramework)' == '$(_ResxTranslatorFirstTfm)'">true</_ResxTranslatorIsFirstTfm>

		<!-- 'dotnet publish' setzt _IsPublishing schon VOR dem Kompilieren -->
		<_ResxTranslatorIsPublishing>false</_ResxTranslatorIsPublishing>
		<_ResxTranslatorIsPublishing Condition="'$(_IsPublishing)' == 'true'">true</_ResxTranslatorIsPublishing>

		<_ResxTranslatorProjectDir>$(MSBuildProjectDirectory)/</_ResxTranslatorProjectDir>
	</PropertyGroup>

	<!-- TRICK: TaskHostFactory zwingt MSBuild, den Task in einem separaten Prozess zu starten. -->
	<!-- Dadurch wird die DLL NIEMALS von Visual Studio selbst gesperrt! -->
	<UsingTask Condition="'$(ResxTranslatorTaskExists)' == 'true'"
	           TaskName="NetAI.ResxTranslator.Tasks.ResxTranslatorTask"
	           AssemblyFile="$(ResxTranslatorTaskAssembly)"
	           TaskFactory="TaskHostFactory" />

	<!-- Warnung statt stillem Nichtstun, wenn die Task-DLL nicht gefunden wurde -->
	<Target Name="ResxTranslatorAssemblyMissing"
	        BeforeTargets="PrepareForBuild"
	        Condition="'$(ResxTranslatorEnabled)' != 'false' And '$(DesignTimeBuild)' != 'true' And '$(ResxTranslatorTaskExists)' != 'true'">
		<Warning Code="RESXT001"
		         Text="NetAI.ResxTranslator: Task-Assembly nicht gefunden ($(ResxTranslatorTaskAssembly)). Es wird nichts übersetzt." />
	</Target>

	<!-- Schema und Einstellungen bereitstellen -->
	<Target Name="SetupResxTranslatorSettings" Condition="'$(ResxTranslatorActive)' == 'true'">
		<Copy SourceFiles="$(MSBuildThisFileDirectory)..\aisettings-schema.json"
		      DestinationFiles="$(MSBuildProjectDirectory)\aisettings-schema.json"
		      Condition="!Exists('$(MSBuildProjectDirectory)\aisettings-schema.json')" />

		<Copy SourceFiles="$(MSBuildThisFileDirectory)..\aisettings.json"
		      DestinationFiles="$(MSBuildProjectDirectory)\aisettings.json"
		      Condition="!Exists('$(MSBuildProjectDirectory)\aisettings.json')" />

		<!-- Remove + Include statt Update: funktioniert auch, wenn die Dateien erst jetzt erzeugt wurden -->
		<ItemGroup>
			<None Remove="aisettings-schema.json" />
			<None Remove="aisettings.json" />
			<None Include="aisettings-schema.json" CopyToOutputDirectory="PreserveNewest" />
			<None Include="aisettings.json" CopyToOutputDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<!-- Führt die Übersetzung aus (nur erstes TFM). -->
	<Target Name="RunResxTranslation"
	        DependsOnTargets="SetupResxTranslatorSettings"
	        Condition="'$(ResxTranslatorActive)' == 'true' And '$(_ResxTranslatorIsFirstTfm)' == 'true'">

		<ResxTranslatorTask ProjectDir="$(_ResxTranslatorProjectDir)"
		                    CurrentConfiguration="$(Configuration)"
		                    IsPublishing="$(_ResxTranslatorIsPublishing)" />
	</Target>

	<!-- Läuft vor dem eigentlichen Build: Übersetzen und neu erzeugte .resx-Dateien noch in diesem Build einbinden -->
	<Target Name="IncludeGeneratedResx"
	        BeforeTargets="PrepareForBuild"
	        DependsOnTargets="RunResxTranslation"
	        Condition="'$(ResxTranslatorActive)' == 'true' And '$(EnableDefaultEmbeddedResourceItems)' != 'false'">

		<ItemGroup>
			<_ResxOnDisk Include="**\*.resx" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
			<_ResxNotYetEmbedded Include="@(_ResxOnDisk)" Exclude="@(EmbeddedResource)" />
			<EmbeddedResource Include="@(_ResxNotYetEmbedded)" />
		</ItemGroup>
	</Target>

	<!-- Fallback für Publish-Wege ohne _IsPublishing (z. B. Visual Studio "Publish"-Button): läuft NACH dem Build -->
	<Target Name="RunResxTranslationOnPublish"
	        BeforeTargets="PrepareForPublish"
	        DependsOnTargets="SetupResxTranslatorSettings"
	        Condition="'$(ResxTranslatorActive)' == 'true' And '$(_ResxTranslatorIsFirstTfm)' == 'true' And '$(_ResxTranslatorIsPublishing)' != 'true'">

		<ResxTranslatorTask ProjectDir="$(_ResxTranslatorProjectDir)"
		                    CurrentConfiguration="$(Configuration)"
		                    IsPublishing="true" />
	</Target>

</Project>
