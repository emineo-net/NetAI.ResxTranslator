<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Nur netstandard2.0: das ist die einzige TFM, die gepackt/kopiert wird.
             TaskHostFactory sorgt dafür, dass MSBuild den Task trotzdem in jedem Zielprojekt laden kann. -->
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<DevelopmentDependency>true</DevelopmentDependency>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackCustomTasksAndDependencies</TargetsForTfmSpecificContentInPackage>

		<!-- WICHTIG: Zwingt NuGet, auch die NuGet-Abhängigkeiten von NetAI.ResxTranslator.Core
             (nicht nur die ProjectReference selbst) physisch nach bin\ zu kopieren. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<!-- ==================== NuGet-Paketmetadaten ==================== -->
		<PackageId>NetAI.ResxTranslator.Tasks</PackageId>
		<Authors>Stephan Emmermann</Authors>
		<Company>emineo-net</Company>
		<Description>MSBuild-Task zur KI-gestützten Übersetzung von .resx-Ressourcendateien (emineo-net).</Description>
		<PackageTags>msbuild;task;ai;resx;translation;localization;emineo</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/emineo-net/NetAI.ResxTranslator</PackageProjectUrl>
		<RepositoryUrl>https://github.com/emineo-net/NetAI.ResxTranslator</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) emineo-net / Stephan Emmermann</Copyright>

		<!-- README aus dem Solution-Root einbinden -->
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Optional: Icon einbinden, sobald vorhanden -->
		<!-- <PackageIcon>icon.png</PackageIcon> -->

		<!-- ==================== Versionierung ==================== -->
		<VersionPrefix>1.0.0</VersionPrefix>
		<BuildTimestamp>$([System.DateTime]::Now.ToString("yyyyMMddHHmm"))</BuildTimestamp>
		<VersionSuffix>dev.$(BuildTimestamp)</VersionSuffix>

		<Version Condition="'$(Configuration)' == 'Debug'">$(VersionPrefix)-$(VersionSuffix)</Version>
		<Version Condition="'$(Configuration)' == 'Release'">$(VersionPrefix)</Version>

		<!-- Reproduzierbare Builds: keine absolute Pfade im Paket -->
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\NetAI.ResxTranslator.Tasks.targets" Pack="true" PackagePath="build\" />
		<!-- Liegen im Paket-Root, damit "..\aisettings.json" relativ zu build\ in der .targets stimmt. -->
		<None Include="aisettings.json" Pack="true" PackagePath="" Condition="Exists('aisettings.json')" />
		<None Include="aisettings-schema.json" Pack="true" PackagePath="" Condition="Exists('aisettings-schema.json')" />
	</ItemGroup>

	<!-- README aus dem Solution-Root ins Paket-Root packen -->
	<ItemGroup>
		<None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NetAI.ResxTranslator.Core\NetAI.ResxTranslator.Core.csproj" PrivateAssets="all" />
	</ItemGroup>

	<!-- Räumt alte Fremd-DLLs aus dem lokalen build/-Ordner auf, bevor neu kopiert wird -->
	<Target Name="CleanLocalBuildFolder" BeforeTargets="CopyTaskAndDependenciesToLocalBuildFolder">
		<ItemGroup>
			<_OldBuildFiles Include="$(MSBuildProjectDirectory)\build\*.dll" />
			<_OldBuildFiles Include="$(MSBuildProjectDirectory)\build\*.pdb" />
		</ItemGroup>
		<Delete Files="@(_OldBuildFiles)" />
	</Target>

	<!-- FÜR LOKALE ENTWICKLUNG: Kopiert Task-DLL + ALLE Abhängigkeiten in den lokalen build/-Ordner -->
	<Target Name="CopyTaskAndDependenciesToLocalBuildFolder" AfterTargets="Build">
		<ItemGroup>
			<LocalTaskFiles Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\*.dll" />
			<LocalTaskFiles Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\*.pdb" />
		</ItemGroup>
		<Copy SourceFiles="@(LocalTaskFiles)" DestinationFolder="$(MSBuildProjectDirectory)\build\" SkipUnchangedFiles="true" Condition="'@(LocalTaskFiles)' != ''" />
	</Target>

	<!-- FÜR DAS NUGET-PAKET: Packt Task-DLL + Core-DLL + Cores NuGet-Abhängigkeiten in tasks\netstandard2.0\ -->
	<Target Name="PackCustomTasksAndDependencies">
		<ItemGroup>
			<_TasksOutputDependencies Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\*.dll"
			                          Exclude="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\NetAI.ResxTranslator.Tasks.dll" />

			<TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\NetAI.ResxTranslator.Tasks.dll">
				<PackagePath>tasks\netstandard2.0\</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="@(_TasksOutputDependencies)">
				<PackagePath>tasks\netstandard2.0\</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<!-- Kopiert nur im Debug-Modus in die lokale Quelle -->
	<Target Name="CopyToLocalFeed" AfterTargets="Pack" Condition="'$(Configuration)' == 'Debug'">
		<ItemGroup>
			<GeneratedPackages Include="$(PackageOutputAbsolutePath)\*.nupkg" />
		</ItemGroup>
		<Copy SourceFiles="@(GeneratedPackages)" DestinationFolder="C:\NuGetLocalSource" SkipUnchangedFiles="false" />
	</Target>

</Project>